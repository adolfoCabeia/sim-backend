generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Municipio {
  id                      String                      @id @default(uuid())
  nome                    String                      @unique
  codigo                  String                      @unique
  provincia               String?
  activo                  Boolean                     @default(true)
  criadoEm                DateTime                    @default(now())
  alteradoEm              DateTime                    @updatedAt
  agendamentos            Agendamento[]
  contactosInstitucionais ContactoInstitucional[]
  conteudosPublicos       ConteudoPublico[]
  direcoes                Direcao[]
  intercambiosRecebidos   Intercambio[]
  pagamentos              Pagamento[]
  pedidosValidacao        PedidoValidacaoIdentidade[]
  processosGenericos      ProcessoGenerico[]
  utilizadores            Utilizador[]
  ocorrencias             Ocorrencia[]
  receitas                Receita[]
  servicos                Servico[]

  @@map("municipios")
}

enum TipoCentro {
  ACOLHIMENTO_INFANTIL
  ACOLHIMENTO_IDOSOS
  COZINHA_SOCIAL
  MISTO
  OUTRO
}

enum EstadoCentro {
  ATIVO
  INATIVO
  EM_MANUTENCAO
}

enum NivelRiscoZona {
  BAIXO
  MEDIO
  ALTO
}

// TipoCasoSensivel, EstadoCasoSensivel, AcaoAuditoriaCaso e os models
// CasoSensivel/AcessoCasoSensivel foram MOVIDOS para
// casos-sensiveis/prisma-caso-sensivel.prisma (versão com campos
// cifrados e soft delete) — não os dupliquem aqui.

enum TipoPedidoApoio {
  MICROCREDITO
  HABITACAO
  APOIO_IDOSO
  CESTA_BASICA
  OUTRO
}

enum EstadoPedidoApoio {
  EM_ANALISE
  DEFERIDO
  INDEFERIDO
  CANCELADO
}

enum TipoPrograma {
  EMPODERAMENTO_GENERO
  MICROCREDITO_COLETIVO
  OUTRO
}

enum EstadoPrograma {
  ATIVO
  CONCLUIDO
  CANCELADO
}

/// Cadastro e gestão operacional de cada centro (acolhimento, cozinha social).
model CentroAcolhimento {
  id             String  @id @default(uuid())
  municipioId    String
  departamentoId String
  departamento   Direcao @relation(fields: [departamentoId], references: [id])

  nome      String
  tipo      TipoCentro
  bairro    String
  endereco  String?
  latitude  Float?
  longitude Float?

  capacidadeMaxima Int?
  ocupacaoAtual    Int  @default(0)

  responsavelNome     String?
  responsavelContacto String?

  estado      EstadoCentro @default(ATIVO)
  observacoes String?

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  distribuicoes DistribuicaoKit[]

  @@index([municipioId, estado])
  @@index([municipioId, tipo])
  @@map("centros_acolhimento")
}

model ZonaSensivel {
  id          String         @id @default(uuid())
  municipioId String
  bairro      String
  nivelRisco  NivelRiscoZona
  latitude    Float?
  longitude   Float?
  descricao   String?
  criadoEm    DateTime       @default(now())
  alteradoEm  DateTime       @updatedAt

  beneficiarios Beneficiario[]

  @@index([municipioId, nivelRisco])
  @@map("zonas_sensiveis")
}

/// Registo central de pessoas/famílias vulneráveis. Não-restrito — é o
/// cadastro geral. Os CASOS SENSÍVEIS (violência/abuso) são um modelo à
/// parte, com acesso e auditoria próprios (ver CasoSensivel).
model Beneficiario {
  id          String @id @default(uuid())
  municipioId String

  nome                  String
  bairro                String
  contacto              String?
  numeroMembrosAgregado Int? // dimensão do agregado familiar, se aplicável

  zonaSensivelId String?
  zonaSensivel   ZonaSensivel? @relation(fields: [zonaSensivelId], references: [id])

  criancasSemRegistoCivil Int @default(0)

  ativo       Boolean @default(true)
  observacoes String?

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  pedidosApoio   PedidoApoio[]
  distribuicoes  DistribuicaoKit[]
  casosSensiveis CasoSensivel[]
  participacoes  ParticipanteProgramas[]

  @@index([municipioId, bairro])
  @@index([municipioId, zonaSensivelId])
  @@map("beneficiarios")
}

enum TipoCasoSensivel {
  VIOLENCIA_ABUSO
  SEM_REGISTO_CIVIL
  OUTRO
}

enum EstadoCasoSensivel {
  ABERTO
  EM_ACOMPANHAMENTO
  ENCAMINHADO
  ENCERRADO
}

enum AcaoAuditoriaCaso {
  VISUALIZACAO
  CRIACAO
  EDICAO
  ELIMINACAO
  RESTAURACAO
}

/// ACESSO RESTRITO E CIFRADO. Casos de crianças em violência/abuso, ou
/// sem registo civil com acompanhamento activo.
model CasoSensivel {
  id          String @id @default(uuid())
  municipioId String

  beneficiarioId String?
  beneficiario   Beneficiario? @relation(fields: [beneficiarioId], references: [id])

  tipo                   TipoCasoSensivel
  descricaoCifrada       String             @db.Text // AES-256-GCM — nunca texto simples
  encaminhadoParaCifrado String?            @db.Text // idem; ex.: "Câmara de Menores", "Hospital"
  estado                 EstadoCasoSensivel @default(ABERTO)
  dataDeteccao           DateTime

  registadoPorId String // FK solta para Utilizador — sem @relation, ver nota acima

  // --- Soft delete ---
  eliminadoEm      DateTime?
  eliminadoPorId   String?
  motivoEliminacao String?

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  acessos AcessoCasoSensivel[]

  @@index([municipioId, estado])
  @@index([municipioId, tipo])
  @@index([municipioId, eliminadoEm])
  @@map("casos_sensiveis")
}

/// Registo de auditoria imutável — nunca se actualiza nem apaga uma linha,
/// só se inserem novas. Cobre visualizações, criação, edição, eliminação
/// (soft) e restauro.
model AcessoCasoSensivel {
  id             String            @id @default(uuid())
  casoSensivelId String
  casoSensivel   CasoSensivel      @relation(fields: [casoSensivelId], references: [id])
  utilizadorId   String // FK solta para Utilizador — sem @relation
  acao           AcaoAuditoriaCaso
  criadoEm       DateTime          @default(now())

  @@index([casoSensivelId, criadoEm])
  @@index([utilizadorId, criadoEm])
  @@map("acessos_casos_sensiveis")
}

model PedidoApoio {
  id          String @id @default(uuid())
  municipioId String

  beneficiarioId String
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id])

  tipo   TipoPedidoApoio
  estado EstadoPedidoApoio @default(EM_ANALISE)

  valorAprovado       Decimal? @db.Decimal(12, 2) // ex.: montante de microcrédito
  motivoIndeferimento String?
  observacoes         String?

  resolvidoPorId String?
  resolvidoPor   Utilizador? @relation("PedidoApoioResolvidoPor", fields: [resolvidoPorId], references: [id])

  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?

  @@index([municipioId, estado])
  @@index([municipioId, tipo])
  @@index([municipioId, beneficiarioId])
  @@map("pedidos_apoio")
}

/// Registo de distribuição de kits de cesta básica. `requisicaoId` é uma
/// ligação leve (opcional) ao módulo de Logística — ver TODO no README
/// de integração sobre como apertar isto ao vosso modelo real de stock.
model DistribuicaoKit {
  id          String @id @default(uuid())
  municipioId String

  beneficiarioId String
  beneficiario   Beneficiario @relation(fields: [beneficiarioId], references: [id])

  centroAcolhimentoId String?
  centroAcolhimento   CentroAcolhimento? @relation(fields: [centroAcolhimentoId], references: [id])

  quantidadeKits   Int        @default(1)
  requisicaoId     String? // TODO: ligar ao model Requisicao real da Logística
  distribuidoPorId String
  distribuidoPor   Utilizador @relation("DistribuicaoKitRealizadoPor", fields: [distribuidoPorId], references: [id])
  observacoes      String?

  criadoEm DateTime @default(now())

  @@index([municipioId, criadoEm])
  @@index([municipioId, beneficiarioId])
  @@map("distribuicoes_kits")
}

model ProgramaSocial {
  id          String @id @default(uuid())
  municipioId String

  nome       String
  tipo       TipoPrograma
  descricao  String?
  dataInicio DateTime
  dataFim    DateTime?
  estado     EstadoPrograma @default(ATIVO)

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  participantes ParticipanteProgramas[]

  @@index([municipioId, estado])
  @@index([municipioId, tipo])
  @@map("programas_sociais")
}

model ParticipanteProgramas {
  id             String         @id @default(uuid())
  programaId     String
  programa       ProgramaSocial @relation(fields: [programaId], references: [id])
  beneficiarioId String
  beneficiario   Beneficiario   @relation(fields: [beneficiarioId], references: [id])
  dataInscricao  DateTime       @default(now())
  observacoes    String?

  @@unique([programaId, beneficiarioId])
  @@map("participantes_programas")
}

enum BemCategoria {
  MOVEIS
  IMOVEL_DOMINIO_PUBLICO
  IMOVEL_DOMINIO_PRIVADO
  INTANGIVEIS
  VEICULO
}

enum BemEstado {
  OPERACIONAL
  TRANSFERIDO
  ABATIDO
  MAU
  OBSOLETO
  AVARIADO
}

enum SituacaoJuridica {
  REGULAR
  IRREGULAR
  EM_REGULARIZACAO
}

enum EstadoOcupacao {
  LIVRE
  OCUPADO
  OCUPADO_ILEGALMENTE
}

enum BemMovimentoTipo {
  AQUISICAO
  TRANSFERENCIA
  ABATIMENTO
  MANUTENCAO
}

enum BemHistoricoTipo {
  CRIACAO
  EDICAO
  TRANSFERENCIA
  MANUTENCAO
  ABATIMENTO
  REGULARIZACAO_JURIDICA
}

model Bem {
  id          String       @id @default(uuid())
  municipioId String
  categoria   BemCategoria

  // Campos comuns
  designacao    String
  localizacao   String
  estado        BemEstado @default(OPERACIONAL)
  tempoVidaUtil Int? // anos
  dataAquisicao DateTime?
  criadoPorId   String
  alteradoPorId String?
  criadoEm      DateTime  @default(now())
  alteradoEm    DateTime  @updatedAt
  direcaoId     String?

  direcao Direcao? @relation(fields: [direcaoId], references: [id])

  marca      String?
  modelo     String?
  cor        String?
  observacao String? @db.Text

  // Imóveis (terrenos/edifícios)
  extensao             Float? // metros
  largura              Float? // metros
  areaImplantada       Float? // m²
  areaConstruida       Float? // m²
  numeroCompartimentos Int?
  areaInstalada        Float? // m²
  piso                 String?

  // Veículos específicos
  chassi          String?
  numeroMatricula String?
  numeroLugares   Int?
  tipoCombustivel String?

  // Intangíveis
  ticketMarca        String?
  logotipoUrl        String?
  numeroRegistoMarca String?

  fachadas               BemFachada[]
  imagens                BemImagem[]
  historico              BemHistorico[]
  movimentos             BemMovimento[]
  manutencoesProgramadas ManutencaoProgramada[] // ← ADICIONAR no final do model Bem
  regularizacaoJuridica  BemRegularizacaoJuridica?
  frotaOperacional       FrotaOperacional?

  @@index([municipioId])
  @@index([categoria])
  @@index([estado])
  @@index([direcaoId])
}

model BemFachada {
  id        String  @id @default(uuid())
  bemId     String
  bem       Bem     @relation(fields: [bemId], references: [id], onDelete: Cascade)
  direcao   String // NORTE, SUL, SUDOESTE, LESTE
  imagemUrl String?
  descricao String?

  @@unique([bemId, direcao])
}

model BemImagem {
  id       String   @id @default(uuid())
  bemId    String
  bem      Bem      @relation(fields: [bemId], references: [id], onDelete: Cascade)
  url      String
  legenda  String?
  criadoEm DateTime @default(now())
}

model BemHistorico {
  id              String           @id @default(uuid())
  bemId           String
  bem             Bem              @relation(fields: [bemId], references: [id], onDelete: Cascade)
  tipo            BemHistoricoTipo
  descricao       String
  utilizadorId    String
  data            DateTime         @default(now())
  dadosAnteriores Json? // snapshot parcial antes da alteração
}

model BemMovimento {
  id               String           @id @default(uuid())
  bemId            String
  bem              Bem              @relation(fields: [bemId], references: [id], onDelete: Cascade)
  tipo             BemMovimentoTipo
  descricao        String
  direcaoOrigemId  String?
  direcaoDestinoId String?
  utilizadorId     String
  data             DateTime         @default(now())
  valor            Float?
  observacao       String?
}

model BemRegularizacaoJuridica {
  id    String @id @default(uuid())
  bemId String @unique
  bem   Bem    @relation(fields: [bemId], references: [id], onDelete: Cascade)

  situacaoJuridica     SituacaoJuridica @default(IRREGULAR)
  estadoOcupacao       EstadoOcupacao   @default(LIVRE)
  historicoDocumental  String?          @db.Text
  alertaIrregularidade Boolean          @default(false)

  processos Json?

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt
}

enum TipoMovimentoStock {
  ENTRADA
  SAIDA
  AJUSTE
}

enum TipoServicoContinuo {
  ENERGIA
  INTERNET
  VOZ
  TELEVISAO
}

enum EstadoServicoContinuo {
  ACTIVO
  SUSPENSO
  CANCELADO
}

model ItemStock {
  id                       String    @id @default(uuid())
  municipioId              String
  codigo                   String
  designacao               String
  categoria                String // "BEM_CONSUMO", "MATERIAL_ESCRITORIO", "LIMPEZA", etc.
  unidadeMedida            String
  quantidadeActual         Int       @default(0)
  quantidadeMinima         Int       @default(0)
  pontoReposicao           Int       @default(0)
  cicloReposicaoMeses      Int?
  fornecedorPadrao         String?
  ultimoAlertaEnviadoEm    DateTime?
  ultimoNivelAlertaEnviado String?
  criadoEm                 DateTime  @default(now())
  alteradoEm               DateTime  @updatedAt

  movimentos MovimentoStock[]

  @@unique([municipioId, codigo])
  @@index([municipioId])
  @@index([quantidadeActual])
  @@map("itens_stock")
}

model MovimentoStock {
  id                  String             @id @default(uuid())
  itemStockId         String
  tipo                TipoMovimentoStock
  quantidade          Int
  quantidadeAnterior  Int
  quantidadePosterior Int
  motivo              String
  documentoRef        String?
  utilizadorId        String
  criadoEm            DateTime           @default(now())

  itemStock ItemStock @relation(fields: [itemStockId], references: [id], onDelete: Cascade)

  @@index([itemStockId])
  @@index([criadoEm])
  @@map("movimentos_stock")
}

model ServicoContinuo {
  id             String                @id @default(uuid())
  municipioId    String
  tipo           TipoServicoContinuo
  designacao     String
  fornecedor     String?
  numeroContrato String?
  estado         EstadoServicoContinuo @default(ACTIVO)

  dataUltimoCarregamento   DateTime?
  valorUltimoCarregamento  Decimal?  @db.Decimal(12, 2)
  consumoEstimadoDias      Int?
  dataPrevistaEsgotamento  DateTime?
  dataProximoCarregamento  DateTime?
  alertaDiasAntes          Int       @default(7)
  ultimoAlertaEnviadoEm    DateTime?
  ultimoNivelAlertaEnviado String?

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  @@index([municipioId])
  @@index([tipo])
  @@index([estado])
  @@index([dataPrevistaEsgotamento])
  @@map("servicos_continuos")
}

model ManutencaoProgramada {
  id                       String    @id @default(uuid())
  municipioId              String
  bemId                    String
  bem                      Bem       @relation(fields: [bemId], references: [id]) // ← ADICIONAR
  tipoManutencao           String
  periodicidadeMeses       Int
  dataUltima               DateTime?
  dataProxima              DateTime?
  especificacoesTecnicas   String?   @db.Text
  responsavelId            String?
  estado                   String    @default("AGENDADA")
  observacoes              String?
  ultimoAlertaEnviadoEm    DateTime?
  ultimoNivelAlertaEnviado String?
  criadoEm                 DateTime  @default(now())
  alteradoEm               DateTime  @updatedAt

  @@index([municipioId])
  @@index([bemId])
  @@index([dataProxima])
  @@index([estado])
  @@map("manutencoes_programadas")
}

model FrotaOperacional {
  id                  String    @id @default(uuid())
  municipioId         String
  bemId               String    @unique
  bem                 Bem       @relation(fields: [bemId], references: [id]) // ← ADICIONAR
  alocacaoActual      String?
  kmActual            Int       @default(0)
  dataUltimaRevisao   DateTime?
  kmProximaRevisao    Int?
  dataProximaRevisao  DateTime?
  consumoMedio        Decimal?  @db.Decimal(5, 2)
  ultimoAbastecimento DateTime?
  tipoCombustivel     String?
  criadoEm            DateTime  @default(now())
  alteradoEm          DateTime  @updatedAt

  @@index([municipioId])
  @@index([alocacaoActual])
  @@map("frota_operacional")
}

model Direcao {
  id                               String                  @id @default(uuid())
  municipioId                      String
  nome                             String
  sigla                            String
  descricao                        String?
  tipo                             TipoOrgao               @default(DIRECCAO_EXECUTIVA_DESCONCENTRADA)
  areaResponsabilidade             AreaResponsabilidade?
  responsavel                      String?
  contacto                         String?
  permiteIntercambioInterMunicipal Boolean                 @default(false)
  criadoEm                         DateTime                @default(now())
  alteradoEm                       DateTime                @updatedAt
  contactosInstitucionais          ContactoInstitucional[]
  departamentos                    Departamento[]
  municipio                        Municipio               @relation(fields: [municipioId], references: [id])
  documentos                       Documento[]
  pastas                           Pasta[]
  intercambiosEnviados             Intercambio[]
  processosGenericosAtual          ProcessoGenerico[]      @relation("ProcessosGenericosAtual")
  processosGenericosDespachada     ProcessoGenerico[]      @relation("ProcessosGenericosDespachada")
  processosGenericosOrigem         ProcessoGenerico[]      @relation("ProcessosGenericosOrigem")
  utilizadores                     Utilizador[]
  requisicoesLogistica             RequisicaoLogistica[]
  bems                             Bem[]
  centrosAcolhimento               CentroAcolhimento[]
  funcionarios                     Funcionario[]
  receitas                         Receita[]
  servicos                         Servico[]

  @@unique([municipioId, sigla])
  @@unique([municipioId, nome])
  @@index([tipo])
  @@map("direcoes")
}

enum RequisicaoCategoria {
  BEM
  SERVICO
  EMPREITADA
}

enum RequisicaoEstado {
  RASCUNHO
  SUBMETIDA
  APROVADA
  REJEITADA
  EM_EXECUCAO
  CONCLUIDA
}

enum TipoServico {
  REPARACAO
  MONTAGEM
  MELHORIA
  MANUTENCAO
  CONSTRUCAO_SOFTWARE
}

enum EstadoObra {
  NAO_INICIADA
  EM_CURSO
  PARADA
  CONCLUIDA
}

model RequisicaoLogistica {
  id          String              @id @default(uuid())
  municipioId String
  numero      String              @unique
  categoria   RequisicaoCategoria
  estado      RequisicaoEstado    @default(RASCUNHO)

  // Campos comuns
  designacao    String?
  destinatario  String?
  observacao    String?   @db.Text
  direcaoId     String?
  requerenteId  String
  aprovadoPorId String?
  aprovadoEm    DateTime?

  // === SERVIÇO ===
  tipoServico            TipoServico?
  dataProximaAccao       DateTime?
  beneficiarioServico    String?
  especificacoesTecnicas String?      @db.Text

  // === EMPREITADA ===
  dataInicioObra      DateTime?
  estadoObra          EstadoObra?
  prazoExecucao       Int? // dias
  percentagemExecucao Int?        @default(0) // 0-100

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  // Relações
  direcao    Direcao?          @relation(fields: [direcaoId], references: [id])
  requerente Utilizador        @relation(fields: [requerenteId], references: [id])
  itens      RequisicaoItem[]
  anexos     RequisicaoAnexo[]

  @@index([municipioId])
  @@index([categoria])
  @@index([estado])
  @@index([direcaoId])
  @@map("requisicoes_logistica")
}

model RequisicaoItem {
  id             String  @id @default(uuid())
  requisicaoId   String
  tipoBem        String // ex: "Óleo", "Papel A4", "Açúcar"
  unidadeMedida  String // ex: "litros", "kg", "resma"
  quantidade     Decimal @db.Decimal(10, 2)
  especificacoes String? // marca, referência, peso, etc.

  requisicao RequisicaoLogistica @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)

  @@index([requisicaoId])
  @@map("requisicao_itens")
}

model RequisicaoAnexo {
  id           String   @id @default(uuid())
  requisicaoId String
  storageKey   String
  direcao      String? // NORTE, SUL, ESTE, OESTE (para empreitadas)
  descricao    String?
  criadoEm     DateTime @default(now())

  requisicao RequisicaoLogistica @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)

  @@index([requisicaoId])
  @@map("requisicao_anexos")
}

model Departamento {
  id           String       @id @default(uuid())
  direcaoId    String
  nome         String
  descricao    String?
  criadoEm     DateTime     @default(now())
  alteradoEm   DateTime     @updatedAt
  direcao      Direcao      @relation(fields: [direcaoId], references: [id], onDelete: Cascade)
  utilizadores Utilizador[]

  @@unique([direcaoId, nome])
  @@map("departamentos")
}

model Perfil {
  id                   String                      @id @default(uuid())
  nome                 String                      @unique
  descricao            String?
  acessoIlimitadoPonto Boolean                     @default(false)
  activo               Boolean                     @default(true)
  sistemico            Boolean                     @default(false)
  criadoEm             DateTime                    @default(now())
  alteradoEm           DateTime                    @updatedAt
  pedidosSolicitantes  PedidoValidacaoIdentidade[]
  permissoes           PerfilPermissao[]
  utilizadores         UtilizadorPerfil[]

  @@map("perfis")
}

model Permissao {
  id        String            @id @default(uuid())
  recurso   String
  accao     String
  chave     String            @unique
  descricao String?
  perfis    PerfilPermissao[]

  @@unique([recurso, accao])
  @@map("permissoes")
}

model PerfilPermissao {
  id          String    @id @default(uuid())
  perfilId    String
  permissaoId String
  criadoEm    DateTime  @default(now())
  perfil      Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao   Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([perfilId, permissaoId])
  @@map("perfis_permissoes")
}

model UtilizadorPerfil {
  id             String      @id @default(uuid())
  utilizadorId   String
  perfilId       String
  atribuidoPorId String?
  criadoEm       DateTime    @default(now())
