model Documento {
  id           String        @id @default(uuid())
  municipioId  String
  pastaId      String?
  direcaoId    String?
  utilizadorId String?
  tipo         String?
  nome         String
  storageKey   String
  nomeOriginal String?
  descricao    String?
  criadoEm     DateTime      @default(now())
  alteradoEm   DateTime      @updatedAt
  pasta        Pasta?        @relation(fields: [pastaId], references: [id])
  direcao      Direcao?      @relation(fields: [direcaoId], references: [id])
  utilizador   Utilizador?   @relation(fields: [utilizadorId], references: [id])
  diplomaLegal DiplomaLegal?
  planoGepe    PlanoGepe?

  @@index([municipioId, pastaId])
  @@index([direcaoId])
  @@index([utilizadorId])
  @@map("documentos")
}

/**
 * Biblioteca Jurídica Digital (secção 10.1 do documento técnico) —
 * "legislação municipal, posturas municipais, regulamento de taxas,
 * plano director municipal, contencioso e activo, Diário da República,
 * decretos presidenciais, despachos ministeriais... indexados e
 * pesquisáveis. Acervo inicial de aproximadamente 200 diplomas legais".
 * Reaproveita o Arquivo Digital (`Documento`) para o ficheiro em si
 * (PDF do diploma) — este modelo só guarda os metadados que tornam o
 * acervo pesquisável por categoria/número/data, que um documento genérico
 * não tem.
 */
model DiplomaLegal {
  id             String                @id @default(uuid())
  municipioId    String
  categoria      CategoriaDiplomaLegal
  numero         String?
  titulo         String
  dataPublicacao DateTime?
  estado         EstadoDiplomaLegal    @default(VIGENTE)
  documentoId    String?               @unique
  criadoPorId    String
  criadoEm       DateTime              @default(now())
  alteradoEm     DateTime              @updatedAt

  documento Documento? @relation(fields: [documentoId], references: [id])

  @@index([municipioId, categoria])
  @@index([municipioId, estado])
  @@map("diplomas_legais")
}

enum CategoriaDiplomaLegal {
  LEGISLACAO_MUNICIPAL
  POSTURA_MUNICIPAL
  REGULAMENTO_TAXAS
  PLANO_DIRECTOR_MUNICIPAL
  CONTENCIOSO
  DIARIO_REPUBLICA
  DECRETO_PRESIDENCIAL
  DESPACHO_MINISTERIAL
  OUTRO
}

enum EstadoDiplomaLegal {
  VIGENTE
  REVOGADO
}

/**
 * GEPE — Gabinete de Estudos, Planeamento e Estatística (secção 11 do
 * documento técnico). Cobre o Plano de Desenvolvimento Municipal (PDM) e
 * os Planos Anuais de Actividades com o MESMO modelo (`tipo`
 * discrimina), já que estruturalmente são o mesmo fluxo: elaborar →
 * submeter ao Administrador → aprovar/rejeitar. "Acompanhamento de
 * investimentos públicos" (ligação a Empreitadas) NÃO tem modelo próprio
 * aqui — é uma vista de leitura sobre `ProcessoGenerico` (tipo
 * REQUISICAO_EMPREITADA), para não duplicar dados que já existem.
 */
model PlanoGepe {
  id                       String          @id @default(uuid())
  municipioId              String
  tipo                     TipoPlanoGepe
  titulo                   String
  ano                      Int?
  periodoInicio            DateTime?
  periodoFim               DateTime?
  objectivos               String?
  estado                   EstadoPlanoGepe @default(RASCUNHO)
  documentoId              String?         @unique
  submetidoPorId           String?
  submetidoEm              DateTime?
  aprovadoPorId            String?
  aprovadoEm               DateTime?
  observacoesAdministrador String?
  criadoPorId              String
  criadoEm                 DateTime        @default(now())
  alteradoEm               DateTime        @updatedAt

  documento Documento? @relation(fields: [documentoId], references: [id])

  @@index([municipioId, tipo])
  @@index([municipioId, estado])
  @@map("planos_gepe")
}

enum TipoPlanoGepe {
  PDM
  PLANO_ANUAL_ACTIVIDADES
}

enum EstadoPlanoGepe {
  RASCUNHO
  SUBMETIDO
  APROVADO
  REJEITADO
}

enum NotificacaoTipo {
  PROCESSO_SUBMETIDO
  PROCESSO_ATRIBUIDO
  PROCESSO_ATUALIZADO
  PROCESSO_CONCLUIDO
  ACAO_REQUERIDA
  SISTEMA
  OCORRENCIA_MENSAGEM
  OCORRENCIA_ATUALIZADA
  OCORRENCIA_ATRIBUIDA
}

model Notificacao {
