  utilizadorId String
  titulo       String
  mensagem     String
  lida         Boolean         @default(false)
  lidaEm       DateTime?
  criadoEm     DateTime        @default(now())
  utilizador   Utilizador      @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  tipo         NotificacaoTipo @default(SISTEMA)

  @@index([utilizadorId])
  @@map("notificacoes")
}

model ProcessoGenerico {
  id                        String                      @id @default(uuid())
  municipioId               String
  numero                    String
  tipo                      TipoProcessoGenerico
  origem                    OrigemProcessoGenerico
  assunto                   String
  requerenteUtilizadorId    String?
  direcaoOrigemId           String?
  direcaoAtualId            String?
  direcaoDespachadaId       String?
  responsavelActualId       String?
  estado                    EstadoProcessoGenerico      @default(RECEBIDO)
  resultado                 String?
  localizacaoActual         LocalizacaoProcesso         @default(EXPEDIENTE)
  prazoLegalResposta        DateTime?
  diasAlertaAntesPrazo      Int                         @default(3)
  alertaEnviadoEm           DateTime?
  escaladoEm                DateTime?
  arquivoDigitalEm          DateTime?
  arquivoMortoEm            DateTime?
  aguardaPagamento          Boolean                     @default(false)
  servicoCodigo             String?
  criadoEm                  DateTime                    @default(now())
  alteradoEm                DateTime                    @updatedAt
  agendamentos              Agendamento[]
  pagamentos                Pagamento[]
  direcaoAtual              Direcao?                    @relation("ProcessosGenericosAtual", fields: [direcaoAtualId], references: [id])
  direcaoDespachada         Direcao?                    @relation("ProcessosGenericosDespachada", fields: [direcaoDespachadaId], references: [id])
  direcaoOrigem             Direcao?                    @relation("ProcessosGenericosOrigem", fields: [direcaoOrigemId], references: [id])
  municipio                 Municipio                   @relation(fields: [municipioId], references: [id])
  requerente                Utilizador?                 @relation("ProcessosGenericosComoRequerente", fields: [requerenteUtilizadorId], references: [id])
  responsavelActual         Utilizador?                 @relation("ProcessosGenericosResponsavel", fields: [responsavelActualId], references: [id])
  anexos                    ProcessoGenericoAnexo[]
  transicoes                ProcessoGenericoTransicao[]
  fiscalizacaoDetalhe       FiscalizacaoDetalhe?
  processoGenericoMensagems ProcessoGenericoMensagem[]

  @@unique([municipioId, tipo, direcaoOrigemId, numero])
  @@index([municipioId])
  @@index([estado])
  @@index([tipo])
  @@index([direcaoAtualId])
  @@index([responsavelActualId])
  @@index([prazoLegalResposta])
  @@index([servicoCodigo])
  @@index([localizacaoActual])
  @@index([direcaoDespachadaId])
  @@map("processos_genericos")
}

model ProcessoGenericoMensagem {
