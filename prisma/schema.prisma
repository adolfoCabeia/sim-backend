  signatarioId      String
  tipoAssinatura    String
  algoritmo         AlgoritmoAssinatura  @default(ED25519)
  assinaturaDigital String?              // Ed25519, base64 — null para registos legado
  assinaturaHmac    String?              // HMAC-SHA256, hex — só para registos legado
  ipOrigem          String?
  criadoEm          DateTime             @default(now())

  @@index([emissaoId])
}
model Pasta {
  id          String   @id @default(uuid())
  municipioId String
  nome        String
  pastaPaiId  String?
  direcaoId   String?
  criadoPorId String
  criadoEm    DateTime @default(now())
  alteradoEm  DateTime @updatedAt

  pastaPai   Pasta?      @relation("SubPastas", fields: [pastaPaiId], references: [id], onDelete: Cascade)
  subPastas  Pasta[]     @relation("SubPastas")
  direcao    Direcao?    @relation(fields: [direcaoId], references: [id])
  documentos Documento[]

  @@index([municipioId, pastaPaiId])
  @@index([municipioId, direcaoId])
  @@map("pastas")
