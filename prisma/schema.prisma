model Servico {
  id                   String                    @id @default(uuid())
  municipioId          String
  codigo               String
  nome                 String
  descricao            String
  tipoProcesso         TipoProcessoGenerico
  direcaoResponsavelId String
  origensPermitidas    OrigemProcessoGenerico[]
  pago                 Boolean                   @default(false)
  valorReferenciaKz    Decimal?                  @db.Decimal(12, 2)
  fonte                String?
  prazoDiasCorridos    Int                       @default(15)
  diasAlertaAntesPrazo Int                       @default(3)
  activo               Boolean                   @default(true)
  criadoPorId          String?
  alteradoPorId        String?
  criadoEm             DateTime                  @default(now())
  alteradoEm           DateTime                  @updatedAt
  municipio            Municipio                 @relation(fields: [municipioId], references: [id])
  direcaoResponsavel   Direcao                   @relation(fields: [direcaoResponsavelId], references: [id])
  criadoPor            Utilizador?               @relation("ServicosCriadosPor", fields: [criadoPorId], references: [id])
  alteradoPor          Utilizador?               @relation("ServicosAlteradosPor", fields: [alteradoPorId], references: [id])
  documentosExigidos   ServicoDocumentoExigido[]

  @@unique([municipioId, codigo])
  @@index([municipioId])
  @@index([direcaoResponsavelId])
  @@index([activo])
  @@map("servicos")
}

model ServicoDocumentoExigido {
  id          String  @id @default(uuid())
  servicoId   String
  codigo      String
  nome        String
  obrigatorio Boolean @default(true)
  ordem       Int     @default(0)
  servico     Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([servicoId])
  @@map("servico_documentos_exigidos")
}

model Agendamento {
  id                      String              @id @default(uuid())
  municipioId             String
  utilizadorId            String?
  tipo                    TipoAgendamento
  atendidoPorId           String?
  chamadoPorId            String?
  dataHoraInicio          DateTime
  dataHoraFim             DateTime
  motivo                  String
  estado                  EstadoAgendamento   @default(SOLICITADO)
  observacoes             String?
  processoGenericoId      String?
  numeroSenha             String?
  chegouEm                DateTime?
  atendimentoIniciadoEm   DateTime?
  atendimentoConcluidoEm  DateTime?
  ultimaNotificacaoFilaEm DateTime?
  ofertasComoOrigem       OfertaAntecipacao[] @relation("OfertaOrigem")

  criadoEm         DateTime          @default(now())
  alteradoEm       DateTime          @updatedAt
  chamadoPor       Utilizador?       @relation("AgendamentoChamadoPor", fields: [chamadoPorId], references: [id])
  atendidoPor      Utilizador?       @relation("AgendamentosAtendidos", fields: [atendidoPorId], references: [id])
  municipio        Municipio         @relation(fields: [municipioId], references: [id])
  processoGenerico ProcessoGenerico? @relation(fields: [processoGenericoId], references: [id])
  utilizador       Utilizador?       @relation("AgendamentosComoRequerente", fields: [utilizadorId], references: [id])

  @@index([municipioId])
  @@index([tipo])
  @@index([dataHoraInicio])
  @@index([estado])
  @@map("agendamentos")
}

model ContadorSenha {
  municipioId String
  tipo        String
  dia         String
  contador    Int    @default(0)

  @@id([municipioId, tipo, dia])
  @@map("contadores_senha")
}

enum TipoVinculo {
  QUADRO
  CONTRATO
  ESTAGIARIO
}

enum EstadoFuncionario {
  ATIVO
  EM_FERIAS
  SUSPENSO
  OUTRO
}

enum NivelHabilitacao {
  ENSINO_PRIMARIO
  ENSINO_SECUNDARIO
  TECNICO_MEDIO
  BACHARELATO
  LICENCIATURA
  POS_GRADUACAO
  MESTRADO
  DOUTORAMENTO
  CERTIFICACAO_PROFISSIONAL
  OUTRO
}

enum EstadoPedidoFerias {
  SOLICITADO
  APROVADO
  REJEITADO
  CANCELADO
}

model Funcionario {
  id           String @id @default(uuid())
  municipioId  String
  utilizadorId String @unique

  cargo            String
  contactoTelefone String?
  contactoEmail    String?
  fotografiaUrl    String?
  cvUrl            String?

  tipoVinculo       TipoVinculo
  dataInicioVinculo DateTime
  dataFimVinculo    DateTime?

  estado      EstadoFuncionario @default(ATIVO)
  observacoes String?

  ultimaNotificacaoFimVinculoEm    DateTime?
  ultimaNotificacaoAusenciaPontoEm DateTime?

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  utilizador    Utilizador     @relation(fields: [utilizadorId], references: [id])
  habilitacoes  Habilitacao[]
  pedidosFerias PedidoFerias[]
  registosPonto RegistoPonto[]
  direcao       Direcao?       @relation(fields: [direcaoId], references: [id])
  direcaoId     String?

  @@index([municipioId])
  @@index([municipioId, estado])
  @@index([municipioId, tipoVinculo, dataFimVinculo])
}

model RegistoPonto {
  id            String             @id @default(uuid())
  municipioId   String
  funcionarioId String
  tipo          TipoRegistoPonto
  metodo        MetodoRegistoPonto @default(BIOMETRICO)
  registadoEm   DateTime           @default(now())
  ipOrigem      String?
  observacoes   String?

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([municipioId, funcionarioId, registadoEm])
  @@index([municipioId, registadoEm])
  @@map("registos_ponto")
}

enum TipoRegistoPonto {
  ENTRADA
  SAIDA
}

enum MetodoRegistoPonto {
  BIOMETRICO
  MANUAL // registo manual por RH, com observações obrigatórias (justificação)
}

model Habilitacao {
  id            String      @id @default(uuid())
  municipioId   String
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  nivel           NivelHabilitacao
  curso           String
  instituicao     String
  anoConclusao    Int?
  comprovativoUrl String?

  criadoEm DateTime @default(now())

  @@index([municipioId, funcionarioId])
}

model Ocorrencia {
  id            String   @id @default(uuid())
  numero        String   @unique
  municipioId   String
  criadoPorId   String
  responsavelId String?
  bairroZona    String
  categoria     String
  titulo        String
  descricao     String
  estado        String   @default("REGISTADA")
  prioridade    String   @default("NORMAL")
  comissaoId    String?
  criadoEm      DateTime @default(now())
  alteradoEm    DateTime @updatedAt

  municipio   Municipio            @relation(fields: [municipioId], references: [id])
  criadoPor   Utilizador           @relation("OcorrenciasCriadas", fields: [criadoPorId], references: [id])
  responsavel Utilizador?          @relation("OcorrenciasAtribuidas", fields: [responsavelId], references: [id])
  comissao    ComissaoModeradores? @relation(fields: [comissaoId], references: [id])
  mensagens   OcorrenciaMensagem[]
  anexos      OcorrenciaAnexo[]

  @@index([comissaoId])
  @@index([responsavelId])
}

model OcorrenciaMensagem {
  id           String    @id @default(uuid())
  ocorrenciaId String
  autorId      String
  mensagem     String
  lida         Boolean   @default(false)
  lidaEm       DateTime?
  criadoEm     DateTime  @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id])
  autor      Utilizador @relation(fields: [autorId], references: [id])

  @@index([ocorrenciaId, lida])
}

model OcorrenciaAnexo {
  id           String   @id @default(uuid())
  ocorrenciaId String
  storageKey   String
  nomeFicheiro String
  mimeType     String
  tamanhoBytes Int
  criadoEm     DateTime @default(now())

  ocorrencia Ocorrencia @relation(fields: [ocorrenciaId], references: [id])

  @@index([ocorrenciaId])
}

model ComissaoModeradores {
  id          String @id @default(uuid())
  municipioId String
  utilizadorId String     @unique
  utilizador   Utilizador @relation("ComissaoUtilizador", fields: [utilizadorId], references: [id], onDelete: Cascade)

  bairro               String
  coordenadasLat       Float?
  coordenadasLng       Float?
  presidenteNome       String
  presidenteContacto   String?
  documentacaoLegalUrl String?
  estado               EstadoComissaoModeradores @default(EM_REGULARIZACAO)
  observacoes          String?

  // NOVO: auditoria — que funcionário criou esta comissão
  criadoPorUtilizadorId String?
  criadoPorUtilizador   Utilizador? @relation("ComissaoCriadaPor", fields: [criadoPorUtilizadorId], references: [id])

  criadoEm   DateTime @default(now())
  alteradoEm DateTime @updatedAt

  membros     MembroComissao[]
  ocorrencias Ocorrencia[]

  @@index([municipioId, estado])
  @@index([municipioId, bairro])
  @@map("comissoes_moradores")
}

enum EstadoComissaoModeradores {
  ACTIVA
  INACTIVA
  EM_REGULARIZACAO
}

model MembroComissao {
  id         String   @id @default(uuid())
  comissaoId String
  nome       String
  cargo      String
  contacto   String?
  criadoEm   DateTime @default(now())

  comissao ComissaoModeradores @relation(fields: [comissaoId], references: [id], onDelete: Cascade)

  @@index([comissaoId])
  @@map("membros_comissao")
}

model PedidoFerias {
  id            String      @id @default(uuid())
  municipioId   String
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])

  dataInicio DateTime @db.Date // simplificação: férias em dias inteiros, sem componente de hora
  dataFim    DateTime @db.Date

  diasUteis      Int
  motivo         String?
  estado         EstadoPedidoFerias @default(SOLICITADO)
  aprovadoPorId  String?
  motivoRejeicao String?

  criadoEm    DateTime  @default(now())
  resolvidoEm DateTime?

  @@index([municipioId, funcionarioId, estado])
  @@index([municipioId, estado])
}

model OfertaAntecipacao {
  id                   String                  @id @default(uuid())
  municipioId          String
  agendamentoId        String
  agendamento          Agendamento             @relation("OfertaOrigem", fields: [agendamentoId], references: [id])
  dataHoraInicioAntiga DateTime
  dataHoraFimAntiga    DateTime
  novaDataHoraInicio   DateTime
  novaDataHoraFim      DateTime
  estado               EstadoOfertaAntecipacao @default(PENDENTE)
  expiraEm             DateTime
  criadoEm             DateTime                @default(now())
  resolvidoEm          DateTime?

  @@index([municipioId, agendamentoId, estado])
  @@index([expiraEm])
}

model ConteudoPublico {
  id               String                   @id @default(uuid())
  municipioId      String
  chave            String
  titulo           String
  resumo           String?
  corpo            String
  categoria        CategoriaConteudoPublico @default(OUTRO)
  estadoPublicacao EstadoPublicacaoConteudo @default(RASCUNHO)
  gruposComAcesso  TipoConta[]
  criadoPorId      String?
  publicadoPorId   String?
  publicadoEm      DateTime?
  criadoEm         DateTime                 @default(now())
  alteradoEm       DateTime                 @updatedAt
  criadoPor        Utilizador?              @relation("ConteudoPublicoCriadoPor", fields: [criadoPorId], references: [id])
  municipio        Municipio                @relation(fields: [municipioId], references: [id])
  publicadoPor     Utilizador?              @relation("ConteudoPublicoPublicadoPor", fields: [publicadoPorId], references: [id])

  @@unique([municipioId, chave])
  @@index([municipioId])
  @@index([estadoPublicacao])
  @@index([categoria])
  @@map("conteudos_publicos")
}

model ContactoInstitucional {
  id             String                    @id @default(uuid())
  municipioId    String
  tipo           TipoContactoInstitucional
  nome           String
  cargo          String?
  instituicao    String?
  direcaoId      String?
  telefone       String?
  email          String?
  endereco       String?
  notas          String?
  visivelPublico Boolean                   @default(false)
  criadoPorId    String?
  criadoEm       DateTime                  @default(now())
  alteradoEm     DateTime                  @updatedAt
  criadoPor      Utilizador?               @relation("ContactoInstitucionalCriadoPor", fields: [criadoPorId], references: [id])
  direcao        Direcao?                  @relation(fields: [direcaoId], references: [id])
  municipio      Municipio                 @relation(fields: [municipioId], references: [id])

  @@index([municipioId])
  @@index([tipo])
  @@index([visivelPublico])
  @@index([direcaoId])
  @@map("contactos_institucionais")
}

enum AreaResponsabilidade {
