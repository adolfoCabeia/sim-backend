model EmissaoDocumento {
  id                String                  @id @default(uuid())
  municipioId       String
  referenciaTipo    String
  referenciaId      String
  versao            Int
  conteudoSnapshot  String?                 // null em registos migrados do sistema legado (HMAC)
  hashConteudo      String
  codigoVerificacao String                  @unique
  origemLegado      Boolean                 @default(false)
  criadoEm          DateTime                @default(now())
  substituidaPorId  String?                 @unique
  substituidaPor    EmissaoDocumento?       @relation("Substituicao", fields: [substituidaPorId], references: [id])
  substitui         EmissaoDocumento?       @relation("Substituicao")
